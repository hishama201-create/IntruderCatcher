<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0A1F">

    <!-- شريط الوضع العادي -->
    <LinearLayout
        android:id="@+id/toolbarNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1D1440"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصور المحذوفة تُحذف نهائيًا تلقائيًا بعد 30 يومًا"
            android:textColor="#888888"
            android:textSize="12sp"
            android:padding="8dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- شريط وضع التحديد المتعدد -->
    <LinearLayout
        android:id="@+id/toolbarSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#3A2E7A"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 محدد"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديد الكل"
            android:textColor="#9C6BFF"
            android:padding="8dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnRestoreSelected"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="استرجاع المحدد" />

        <ImageView
            android:id="@+id/btnDeleteSelectedForever"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="حذف نهائي للمحدد" />

        <ImageView
            android:id="@+id/btnCancelSelection"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="إلغاء التحديد" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrash"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سلة المحذوفات فارغة"
        android:textColor="#888888"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

</LinearLayout>
